# Phase 12 — VPS Migration Configuration
# Copy this file to .env and fill in your values

# Control Plane
CONTROL_PLANE_PORT=8443
CONTROL_PLANE_BIND=:8443

# Worker Agent
WORKER_CONTROL_PLANE_URL=https://your-domain.com:8443
WORKER_CREDENTIALS_DIR=/var/lib/dcc/worker-credentials
WORKER_HEARTBEAT_INTERVAL=5

# Website
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Deployment
VPS_HOST=your-vps-ip
VPS_USER=root
DOMAIN=your-domain.com
EMAIL=your-email@example.com
